# python:3.12-slim-bookworm (manifest resolved 2026-10-05)
FROM python@sha256:54c85f3c47607a77f32adec749d3c81d1348bf25833671f512b26a9b6d778cb3

WORKDIR /app

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    build-essential libcairo2 libffi-dev libgdk-pixbuf-2.0-0 \
    libpango-1.0-0 libpangocairo-1.0-0 fontconfig fonts-dejavu-core fonts-noto-core openssl poppler-utils shared-mime-info \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN addgroup --system practiceflow && adduser --system --ingroup practiceflow --home /app practiceflow

COPY --chown=practiceflow:practiceflow . .
RUN mkdir -p /app/storage_data \
    && chown -R practiceflow:practiceflow /app/storage_data \
    && chmod +x /app/docker-entrypoint.sh

USER practiceflow

EXPOSE 8000
ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app/app", "--no-access-log"]
