# python:3.12.14-slim-trixie
FROM python@sha256:b0aed0e0059e9b1527ef57689a7206f32526627b0713e2228a916df62880188a

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libcairo2 libffi-dev libgdk-pixbuf-2.0-0 \
    libpango-1.0-0 libpangocairo-1.0-0 openssl shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN addgroup --system practiceflow && adduser --system --ingroup practiceflow --home /app practiceflow

COPY --chown=practiceflow:practiceflow . .
RUN mkdir -p /app/storage_data \
    && chown -R practiceflow:practiceflow /app/storage_data \
    && chmod +x /app/docker-entrypoint.sh

USER practiceflow

EXPOSE 8000
ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--no-access-log"]
