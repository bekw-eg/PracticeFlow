# python:3.12-alpine3.24 (manifest resolved 2026-10-05)
FROM python@sha256:1eb6b7d4b76454b1de8317863ac3213b678c337b27e604a4e3fb70bddbb2bad7

WORKDIR /app

RUN apk upgrade --no-cache && apk add --no-cache \
    build-base cairo libffi-dev gdk-pixbuf pango fontconfig \
    font-dejavu font-noto openssl poppler-utils shared-mime-info \
    && fc-cache -f

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Preserve the previous Debian image's UID/GID for existing storage volumes.
RUN addgroup -S -g 101 practiceflow && adduser -S -u 100 -G practiceflow -h /app practiceflow

COPY --chown=practiceflow:practiceflow . .
RUN mkdir -p /app/storage_data \
    && chown -R practiceflow:practiceflow /app/storage_data \
    && chmod +x /app/docker-entrypoint.sh

USER practiceflow

EXPOSE 8000
ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app/app", "--no-access-log"]
