# Copy this file to .env before running `docker compose up`.
# Never commit the actual .env file.

# --- Postgres ---
POSTGRES_USER=practiceflow
POSTGRES_PASSWORD=practiceflow
POSTGRES_DB=practiceflow
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
# Built from the Postgres vars above; only change this if you're not using
# the bundled postgres service (e.g. pointing at a managed DB instead).
DATABASE_URL=postgresql+psycopg://practiceflow:practiceflow@postgres:5432/practiceflow
# Generate a unique value before deployment, e.g.: openssl rand -hex 32.
# The real .env supplied with this workspace already has a generated value.
JWT_SECRET_KEY=replace-with-a-unique-64-character-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# CORS origins the backend will accept requests from — must include wherever
# the frontend is actually served from.
CORS_ORIGINS=["http://localhost:5173"]
# Set to "true" to auto-load Demo University seed data on container start
# (safe to leave on in dev — the seed script is idempotent).
SEED_ON_START=true

# --- Product migration ---
# Keep both enabled until DOCX submission can replace the legacy editor.
DOCUMENT_CHECK_ENABLED=true
DOCUMENT_CHECK_STUDENT_SUBMISSIONS_ENABLED=false
LEGACY_DOCUMENT_EDITOR_ENABLED=true

# --- DOCX upload safety (independent from editor image limits) ---
DOCX_MAX_UPLOAD_BYTES=20971520
DOCX_MAX_ZIP_ENTRIES=2048
DOCX_MAX_UNCOMPRESSED_BYTES=104857600
DOCX_MAX_ENTRY_BYTES=20971520
DOCX_MAX_COMPRESSION_RATIO=200

# --- DOCX analyzer worker ---
DOCUMENT_CHECK_WORKER_POLL_SECONDS=1
DOCUMENT_CHECK_WORKER_TIMEOUT_SECONDS=60
DOCUMENT_CHECK_WORKER_LEASE_SECONDS=120
DOCUMENT_CHECK_WORKER_MAX_ATTEMPTS=3
DOCUMENT_CHECK_MAX_FINDINGS=5000
LOCAL_PLAGIARISM_MIN_MATCH_WORDS=8
LOCAL_PLAGIARISM_MAX_MATCHES=300
LOCAL_PLAGIARISM_MAX_CANDIDATE_DOCUMENTS=250
LOCAL_PLAGIARISM_MAX_INDEXED_WORDS=100000

# --- Frontend ---
FRONTEND_PORT=5173
# The frontend runs in the browser, so this must be reachable from the
# HOST machine, not the internal Docker network name.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Email (optional) ---
# Without SMTP, an admin can copy the generated one-time invitation/reset link
# from the management panel. Set these values to send it by email.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@practiceflow.local
