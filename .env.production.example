# Copy to a deployment-only env file outside version control and fill every
# required blank. `docker-compose.prod.yml` refuses to start while they are empty.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
# PostgreSQL accepts at most this many connections. Keep the combined worst
# case of all API and worker pools below this number; see docs/CAPACITY_PLANNING.md.
POSTGRES_MAX_CONNECTIONS=80
# Per API replica: at most DATABASE_POOL_SIZE + DATABASE_MAX_OVERFLOW DB
# connections. These production values support two API replicas (2 * 15), two
# workers (2 * 2), and reserved migration/monitoring/headroom under 80.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
# Export workers run one renderer child at a time. Keep their pool small.
WORKER_DATABASE_POOL_SIZE=2
WORKER_DATABASE_MAX_OVERFLOW=0
WORKER_DATABASE_POOL_TIMEOUT_SECONDS=15
WORKER_DATABASE_POOL_RECYCLE_SECONDS=1800
JWT_SECRET_KEY=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_TOTP_ENCRYPTION_KEY=
# Random secret (at least 32 bytes) used as an HMAC pepper for recovery codes.
MFA_RECOVERY_CODE_PEPPER=
# SHA-256 hashes of two independent offline custodian approvals. Do not store
# the raw values in this file or pass them as command-line arguments.
MFA_BREAK_GLASS_KEY_A_HASH=
MFA_BREAK_GLASS_KEY_B_HASH=
# Independent HMAC pepper for audit request/IP correlation. It must be at
# least 32 random bytes and must not reuse JWT, MFA or recovery-code secrets.
AUDIT_HASH_PEPPER=
CORS_ORIGINS=
FRONTEND_URL=
TRUSTED_PROXY_IPS=

# Deployment-wide migration switches. Set the legacy editor to false only
# after the replacement submission flow is ready for the affected users.
DOCUMENT_CHECK_ENABLED=true
DOCUMENT_CHECK_STUDENT_SUBMISSIONS_ENABLED=false
LEGACY_DOCUMENT_EDITOR_ENABLED=true

# Production storage is private S3-compatible object storage. Do not use a
# public bucket or public object URLs: backend/worker credentials need only
# object read/write/delete rights for this one bucket/prefix.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Use `virtual` for a normal S3 DNS endpoint, `path` for compatible services
# that require it. Compose enforces TLS in production.
S3_ADDRESSING_STYLE=virtual

# Choose an unused private subnet and two distinct static addresses inside it.
# TRUSTED_PROXY_IPS must contain exactly FRONTEND_PROXY_IP and CADDY_PROXY_IP
# (and only additional proxy hops that really exist in front of the backend).
APP_NETWORK_NAME=
APP_NETWORK_SUBNET=
FRONTEND_PROXY_IP=
CADDY_PROXY_IP=

# Values consumed by deployment/caddy/docker-compose.caddy.yml and Caddyfile.
PRACTICEFLOW_DOMAIN=
CADDY_EMAIL=
METRICS_ALLOWED_CIDR=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
LOG_LEVEL=INFO
# Optional error tracking. Leave blank to disable. PracticeFlow strips request,
# user, breadcrumbs, custom extras, exception messages and stack traces first.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Resource-abuse limits. All values are required explicitly in production;
# these defaults are a starting point for a small institution, not a universal
# capacity plan. Bytes use binary units (MiB/GiB).
UPLOAD_MAX_FILE_BYTES=5242880
DOCX_MAX_UPLOAD_BYTES=20971520
DOCX_MAX_ZIP_ENTRIES=2048
DOCX_MAX_UNCOMPRESSED_BYTES=104857600
DOCX_MAX_ENTRY_BYTES=20971520
DOCX_MAX_COMPRESSION_RATIO=200
# The lease must exceed the per-document analyzer timeout. A failed job is
# retried up to MAX_ATTEMPTS; findings are capped to bound database growth.
DOCUMENT_CHECK_WORKER_POLL_SECONDS=1
DOCUMENT_CHECK_WORKER_TIMEOUT_SECONDS=60
DOCUMENT_CHECK_WORKER_LEASE_SECONDS=120
DOCUMENT_CHECK_WORKER_MAX_ATTEMPTS=3
DOCUMENT_CHECK_MAX_FINDINGS=5000
LOCAL_PLAGIARISM_MIN_MATCH_WORDS=8
LOCAL_PLAGIARISM_MAX_MATCHES=300
LOCAL_PLAGIARISM_MAX_CANDIDATE_DOCUMENTS=250
LOCAL_PLAGIARISM_MAX_INDEXED_WORDS=100000
UPLOAD_RATE_LIMIT_REQUESTS=20
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_USER_MAX_FILES=100
UPLOAD_USER_MAX_BYTES=104857600
UPLOAD_USER_QUOTA_WINDOW_SECONDS=86400
UPLOAD_ORGANIZATION_MAX_STORAGE_BYTES=5368709120
UPLOAD_RESERVATION_TTL_SECONDS=900
UPLOAD_QUOTA_RETRY_AFTER_SECONDS=60
EXPORT_USER_RATE_LIMIT_REQUESTS=10
EXPORT_ORGANIZATION_RATE_LIMIT_REQUESTS=60
EXPORT_RATE_LIMIT_WINDOW_SECONDS=60
EXPORT_MAX_CONCURRENT_PER_USER=1
EXPORT_MAX_CONCURRENT_PER_ORGANIZATION=3
# A renderer runs only in export-worker. Hard timeout kills its child process;
# lease must be >= hard timeout so a crashed worker can be recovered safely.
EXPORT_TIMEOUT_SECONDS=45
EXPORT_JOB_RETENTION_SECONDS=86400
EXPORT_WORKER_LEASE_SECONDS=75
EXPORT_WORKER_HARD_TIMEOUT_SECONDS=45
EXPORT_WORKER_QUEUE_TIMEOUT_SECONDS=5
EXPORT_WORKER_REQUEUE_DELAY_SECONDS=1
# Redis-backed liveness signal. The interval must stay below the TTL.
EXPORT_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
EXPORT_WORKER_HEARTBEAT_TTL_SECONDS=90
# Audit events are kept for this many days. The export worker writes a
# retention checkpoint before removing expired rows, preserving hash-chain
# verification of the remaining segment.
AUDIT_RETENTION_DAYS=365
AUDIT_CLEANUP_INTERVAL_SECONDS=21600

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
